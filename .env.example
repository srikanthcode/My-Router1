# ─── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000
PUBLIC_API_BASE_URL=http://localhost:4000

# ─── Database ────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PGlite database (dev).
# Set to a PostgreSQL connection string for production.
DATABASE_URL=
DATABASE_DIR=.data/db
REDIS_URL=

# MongoDB — primary data store when set; the app falls back to embedded
# PGlite if empty or unreachable at boot. Use the mongodb+srv:// form from
# Atlas (Network Access must include your server's IP).
MONGODB_URI=
MONGODB_DB=prorouter

# ─── Auth ────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=720

# ─── Payments — Razorpay ─────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Payments — Stripe ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Upstream AI providers ───────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
PROVIDER_OPENROUTER_API_KEY=
PROVIDER_CUSTOM_OPENAI_API_KEY=
# Server-only gateway credential — used by the API process, never sent to the browser.
PROVIDER_PROROUTER_GATEWAY_API_KEY=
# Upstream gateway base URL (server-side only; not rendered anywhere in the UI).
PROVIDER_PROROUTER_GATEWAY_BASE_URL=https://gpt-code-p2mf.onrender.com/v1

# ─── Security ────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ─── Storage (S3-compatible) ─────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ─── Email ───────────────────────────────────────────────────────────
EMAIL_API_KEY=
EMAIL_FROM=noreply@prorouter.com

# ─── Observability ───────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── Business defaults (overridable in Admin → System Settings) ──────
USD_TO_INR_RATE=97
PLATFORM_FEE_PERCENT=0
FREE_REQUESTS_PER_MINUTE=1
FREE_QUEUE_PRIORITY=5
ASTRA_TRIAL_DAYS=7
ASTRA_DISCOUNT_PERCENT=80
ASTRA_ORIGINAL_PRICE_PAISE=400000
ASTRA_PROMO_PRICE_PAISE=80000
MAX_API_KEYS=20
DEFAULT_TIMEOUT_MS=60000
MAX_RETRIES=2

# ─── Admin seed (development only — never commit real credentials) ───
ADMIN_EMAIL=
ADMIN_PASSWORD=