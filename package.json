{
  "name": "prorouter-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProRouter Backend API Gateway — One API. Every Model.",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --max-old-space-size=384 scripts/start-prod.mjs",
    "start:api": "node --max-old-space-size=384 scripts/start-prod.mjs",
    "db:generate": "npx --yes drizzle-kit@0.31.11 generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/database && tsc -p packages/providers && tsc -p packages/routing && tsc -p apps/api",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@types/node": "^22.13.0",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "fastify": "^5.12.5",
    "mongodb": "^6.21.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}