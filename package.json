{
  "name": "prorouter-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProRouter Backend API Gateway — One API. Every Model.",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev -w @pro/api",
    "build": "tsc -p packages/shared && tsc -p packages/database && tsc -p packages/providers && tsc -p packages/routing && tsc -p apps/api",
    "start": "node scripts/start-prod.mjs",
    "start:api": "npm run start -w @pro/api",
    "db:generate": "npx --yes drizzle-kit@0.31.11 generate",
    "db:migrate": "npm run migrate -w @pro/database",
    "db:migrate:mongo": "npm run migrate:mongo -w @pro/database",
    "db:seed": "npm run seed -w @pro/database",
    "typecheck": "tsc -p packages/shared && tsc -p packages/database && tsc -p packages/providers && tsc -p packages/routing && tsc -p apps/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "stub": "node scripts/stub-provider.mjs"
  },
  "dependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
