{
  "name": "prorouter-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ProRouter Backend API Gateway — One API. Every Model.",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "dev": "tsx apps/api/src/server.ts",
    "build": "echo 'Build OK'",
    "start": "node --max-old-space-size=384 ./node_modules/tsx/dist/cli.mjs apps/api/src/server.ts",
    "start:api": "node --max-old-space-size=384 ./node_modules/tsx/dist/cli.mjs apps/api/src/server.ts",
    "db:generate": "npx --yes drizzle-kit@0.31.11 generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "typecheck": "tsc -p packages/shared && tsc -p packages/database && tsc -p packages/providers && tsc -p packages/routing && tsc -p apps/api",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "concurrently": "^9.2.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
